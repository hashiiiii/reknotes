{% for note in notes %}
  {% render 'note-card', note: note, showMenu: true, processing: note.processing %}
{% endfor %}
{% if hasMore %}
  <div class="note-grid-sentinel" hx-get="/api/notes?cursor={% if nextCursor.pinned %}pinned-{% endif %}{{ nextCursor.id }}" hx-trigger="revealed" hx-swap="outerHTML"></div>
{% endif %}
