{% layout 'base' %}
{% block content %}
<section class="compose-bar" id="compose">
  <form hx-post="/api/notes" hx-target="#note-grid" hx-swap="innerHTML" hx-include=".nav-search-input" hx-on::after-request="if (event.detail.successful) collapseCompose(this)">
    <div class="compose-collapsed" id="compose-trigger" onclick="expandCompose()">
      ノートを入力...
    </div>
    <div class="compose-expanded" id="compose-body" hidden>
      <input type="text" name="title" placeholder="タイトル" required class="compose-title">
      <textarea name="body" placeholder="ノートを書く..." rows="4" required class="compose-body" id="compose-textarea"></textarea>
      <div class="compose-preview" id="compose-preview"></div>
      <div class="compose-actions">
        <button type="button" class="btn" id="preview-btn" onclick="togglePreview()" disabled>プレビュー</button>
        <button type="submit" class="btn btn-primary">投稿</button>
        <button type="button" class="btn" onclick="collapseCompose(this.closest('form'))">閉じる</button>
      </div>
    </div>
  </form>
</section>

<section id="note-grid" class="note-grid">
  {% render 'note-list', notes: notes, hasMore: hasMore, nextCursor: nextCursor %}
</section>

<script src="/static/js/home.js"></script>
{% endblock %}
