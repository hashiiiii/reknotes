{
  "name": "reknotes",
  "version": "0.1.0",
  "description": "Personal knowledge management with auto-organization and fast search",
  "type": "module",
  "scripts": {
    "setup": "ONNXRUNTIME_NODE_INSTALL=${ONNXRUNTIME_NODE_INSTALL:-skip} bun install --frozen-lockfile && bun run build && bun run scripts/setup.ts && ENVIRONMENT=development bun run migrate --apply && ENVIRONMENT=test bun run migrate --apply",
    "build": "bun run scripts/build.ts",
    "dev": "bun run build && bun run --watch src/index.ts",
    "migrate": "bun run scripts/migration/migrate.ts",
    "seed": "bun run scripts/seed/seed.ts",
    "dump": "bun run scripts/backup/dump.ts",
    "restore": "bun run scripts/backup/restore.ts",
    "check": "bunx biome check --write && bunx tsc --noEmit",
    "test": "ENVIRONMENT=test bun test"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.2",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@huggingface/transformers": "^4.3.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "hono-rate-limiter": "^0.5.4",
    "htmx.org": "^2.0.11",
    "liquidjs": "^10.30.1",
    "postgres": "^4.1.1",
    "zenn-content-css": "^0.5.15",
    "zenn-markdown-html": "^0.5.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "trustedDependencies": [
    "esbuild",
    "onnxruntime-node",
    "protobufjs"
  ]
}
