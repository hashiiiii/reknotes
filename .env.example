# Required by every command (dev / test / migrate / seed / dump / restore)
ENVIRONMENT=development
DEPLOYMENT=local
DATABASE_URL=postgresql://reknotes:reknotes@localhost:5432

# Primary object storage (app runtime, also read by compose.local.yaml MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=reknotes
S3_SECRET_ACCESS_KEY=reknotes
S3_BUCKET_NAME=reknotes

# Backup storage: only `bun run dump` / `bun run restore` require these
# (also read by compose.local.yaml backup MinIO)
BACKUP_S3_ENDPOINT=http://localhost:9002
BACKUP_S3_ACCESS_KEY_ID=reknotes-backup
BACKUP_S3_SECRET_ACCESS_KEY=reknotes-backup
BACKUP_S3_BUCKET_NAME=reknotes-backup

# Remote-only variables (CLOUDFLARE_*, DOMAIN, GITHUB_REPOSITORY, OAUTH2_PROXY_*)
# are not needed locally; deploy.yml assembles the remote .env from GitHub Secrets.
